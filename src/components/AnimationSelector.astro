---
// 动画选择器组件 — 5种揭晓动画供选择
---

<!-- 动画选择 -->
<div class="animation-selector">
	<label for="animationSelect">揭晓动画：</label>
	<select id="animationSelect">
		<option value="flash">闪光扩散</option>
		<option value="particle">粒子爆炸</option>
		<option value="elastic" selected>弹性缩放</option>
		<option value="glitch">故障闪烁</option>
		<option value="aurora">极光环绕</option>
	</select>
</div>
