---
// 主交互组件 — 上传+抽人的完整交互区域
// 首页使用此组件，预设页面仅使用抽人部分
import ResultDisplay from './ResultDisplay.astro';
import AnimationSelector from './AnimationSelector.astro';
---

<!-- 上传区域 -->
<section class="upload-zone" id="uploadZone">
	<div class="upload-card">
		<h2>上传学生名单</h2>
		<p class="upload-hint">请上传包含学生名字的文本文件（每行一个名字），或在下方手动输入</p>

		<!-- 文件拖拽上传 -->
		<div class="file-input-wrapper">
			<input
				type="file"
				id="fileInput"
				accept=".txt"
				class="file-input"
			/>
			<label for="fileInput" class="file-label">
				<span class="icon">📄</span>
				<span class="text">选择文件</span>
			</label>
			<span id="fileName" class="file-name">未选择文件</span>
		</div>

		<!-- 手动输入 -->
		<div class="manual-input">
			<p>或者手动输入学生名字：</p>
			<textarea
				id="manualInput"
				placeholder="请输入学生名字，每行一个&#10;例如：&#10;张三&#10;李四&#10;王五"
				rows="5"
			></textarea>
		</div>

		<!-- 加载按钮 -->
		<button id="loadBtn" class="btn btn-primary">
			<span class="icon">✅</span>
			<span class="text">加载名单</span>
		</button>

		<!-- 已加载人数显示 -->
		<div id="studentCount" class="student-count"></div>
	</div>
</section>

<!-- 抽人区域（默认隐藏） -->
<section class="pick-zone" id="pickZone" style="display: none;">
	<div class="pick-card">
		<!-- 结果展示 -->
		<ResultDisplay />

		<!-- 动画选择 -->
		<AnimationSelector />

		<!-- 按钮组：抽人 / 重置 / 返回 -->
		<div class="button-group">
			<button id="pickBtn" class="btn btn-large btn-success">
				<span class="icon">🎲</span>
				<span class="text">点击抽人</span>
			</button>

			<button id="resetBtn" class="btn btn-secondary">
				<span class="icon">🔄</span>
				<span class="text">重新抽取</span>
			</button>

			<button id="backBtn" class="btn btn-outline">
				<span class="icon">⬅️</span>
				<span class="text">返回上传</span>
			</button>
		</div>

		<!-- 抽取历史 -->
		<div class="pick-history" id="pickHistory">
			<h3>抽取历史</h3>
			<ul id="historyList"></ul>
		</div>
	</div>
</section>
