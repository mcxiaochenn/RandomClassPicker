---
// JS2451 班级预设页面
// 从 JSON 导入班级数据，直接进入抽人界面
import BaseLayout from '../layouts/BaseLayout.astro';
import PickResult from '../components/PickResult.astro';
import classData from '../data/classes/js2451.json';

const { class_name, students } = classData;
---

<BaseLayout title={`${class_name} - 班级抽人工具`}>
	<div class="app">
		<header class="app-header">
			<h1>// {class_name} 班抽人工具</h1>
			<p class="tagline">已加载预设名单，共 {students.length} 名同学</p>
		</header>

		<main>
			<section class="pick-zone" id="pickZone" style="display: block;">
				<div class="pick-card">
					<PickResult
						className={class_name}
						studentCount={students.length}
					>
						<!-- 返回首页按钮（通过 slot 注入） -->
						<a href="/" class="btn btn-outline" slot="back-action">
							<span class="icon">⬅️</span>
							<span class="text">返回首页</span>
						</a>
					</PickResult>
				</div>
			</section>
		</main>

		<footer class="footer">
			<p>&copy; 2026 班级抽人工具 | {class_name} 专用</p>
		</footer>
	</div>

	<!-- 音效脚本（内联加载） -->
	<script is:inline src="/scripts/audio.js"></script>
	<!-- 动画系统 -->
	<script is:inline src="/scripts/animation.js"></script>

	<!-- 注入班级数据到全局变量 -->
	<script set:html={`
	window.CLASS_DATA = ${JSON.stringify({ class_name, students })};
	`}></script>

	<!-- 班级页面专用逻辑 -->
	<script src="/scripts/class-page.js" type="module"></script>
</BaseLayout>
