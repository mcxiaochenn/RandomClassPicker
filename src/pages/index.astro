---
// 主页 - 班级抽人工具（通用版本）
// 支持文件上传或手动输入学生名单
import BaseLayout from '../layouts/BaseLayout.astro';
import PickerMain from '../components/PickerMain.astro';
---

<BaseLayout title="抽人工具">
	<div class="app">
		<header class="app-header">
			<h1>// 抽人工具</h1>
			<p class="tagline">公平 · 随机 · 刺激</p>
		</header>

		<main>
			<PickerMain />
		</main>

		<footer class="footer">
			<p>&copy; 2026 班级抽人工具</p>
		</footer>
	</div>

	<!-- 音效脚本（内联加载，确保先于业务脚本） -->
	<script is:inline src="/scripts/audio.js"></script>
	<!-- 动画系统 -->
	<script is:inline src="/scripts/animation.js"></script>
	<!-- 主逻辑脚本（模块模式） -->
	<script src="/scripts/main.js" type="module"></script>
</BaseLayout>
